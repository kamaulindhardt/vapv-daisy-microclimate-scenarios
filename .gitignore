# RStudio / R session state
.Rproj.user/
.Rhistory
.RData
.RDataTmp
.Ruserdata
*.Rproj.user_backup*

# renv (renv/activate.R, renv/settings.json, and renv.lock ARE tracked)
renv/library/
renv/staging/
renv/sandbox/
renv/python/

# Data tiers not committed (large and/or regenerable from the copied raw source;
# see docs/provenance.md, and data/raw/MANIFEST.sha256.csv for integrity).
# data/raw/ is archived separately on Zenodo - see docs/provenance.md.
data/raw/
data/interim/

# targets build cache (regenerated by tar_make(), machine-specific)
_targets/

# Legacy ground-truth fixtures copied from a companion modelling project for
# validation - regenerable by re-copying from that project (see
# validation/README.md), not committed wholesale to keep repo size sane.
tests/fixtures/legacy_baseline/

# Diagnostics / scratch / validation working files
outputs/diagnostics/
validation/reference_values/
validation/*.txt
*.log

# Stray backup/working directories from ad-hoc renumbering or refactor scripts
.renumber_backup/

# MS Office lock files
~$*

# Python (not currently used, kept in case)
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS/editor cruft
Thumbs.db
Desktop.ini
.DS_Store

# Stray R/htmlwidget scratch output at project root (Rplots.pdf: R's default
# device fallback when a plot is drawn with no device open; *.html here:
# ad-hoc htmlwidgets::saveWidget() exports like tar_visnetwork() previews)
/Rplots.pdf
/*.html

# Rendered manuscript output - regenerate with rmarkdown::render(); the
# source .Rmd is what's tracked, not the (large, self-contained) knit result
analysis/*.html
analysis/*.knit.md
analysis/*_files/

# Word versions of docs/ - generated from the .md sources by docs/build_docs.ps1
docs/*.docx
